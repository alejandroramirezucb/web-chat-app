<section class='auth-card auth-card--login'>
  <h1 class='auth-card__title'>Entrada</h1>

  <form class='auth-form' ref='loginFormElement' autocomplete='off'>
    <div class='auth-form__group'>
      <label class='auth-form__label' for='login'>Login</label>
      <input
        class='auth-form__input'
        id='login'
        ref='loginInput'
        name='login'
        type='text'
        autocomplete='off'
      />
      <span ref='loginError' class='auth-form__field-error'></span>
    </div>

    <div class='auth-form__group'>
      <label class='auth-form__label' for='password'>Password</label>
      <input
        class='auth-form__input'
        id='password'
        ref='passwordInput'
        name='password'
        type='password'
        autocomplete='off'
      />
      <span ref='passwordError' class='auth-form__field-error'></span>
    </div>

    <p ref='generalError' class='auth-form__error'></p>

    <button ref='submitButton' class='auth-form__submit' type='button'>Iniciar
      sesión</button>
  </form>

  <button ref='registerLinkButton' class='auth-card__link' type='button'>¿No
    tienes una cuenta?</button>
</section>