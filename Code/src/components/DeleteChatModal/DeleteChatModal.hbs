<div class="delete-chat-modal" aria-hidden="true">
  <div class="delete-chat-modal__overlay"></div>
  <div class="delete-chat-modal__card" role="dialog" aria-labelledby="delete-chat-modal-title">
    <div class="delete-chat-modal__avatar"></div>
    <h2 class="delete-chat-modal__title" id="delete-chat-modal-title">¿Eliminar chat?</h2>
    <p class="delete-chat-modal__name">{{chatName}}</p>
    <div class="delete-chat-modal__actions">
      <button type="button" class="delete-chat-modal__confirm">Eliminar</button>
      <button type="button" class="delete-chat-modal__cancel">Cancelar</button>
    </div>
  </div>
</div>
