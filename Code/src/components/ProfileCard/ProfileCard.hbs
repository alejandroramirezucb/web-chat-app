<section class="profile-card">
  <div data-child="profileAvatar"></div>
  <p class="profile-card__name">{{name}}</p>
  <div data-child="profileFields"></div>
  <div class="profile-card__actions">
    <a class="profile-card__action">Cambiar datos</a>
    <a class="profile-card__action">Cambiar contrasena</a>
    <a class="profile-card__action profile-card__action--danger profile-card__action--logout">Salir</a>
  </div>
</section>
