<section class='profile-card'>
  <div class='profile-card__avatar-wrap'>
    <div ref='profileAvatar'></div>
  </div>
  <p class='profile-card__name'>{{name}}</p>
  {{#if showPasswordForm}}
    <div ref='passwordChangeForm'></div>
  {{else}}
    {{#if showEditForm}}
      <div ref='profileEditForm'></div>
    {{else}}
      <div ref='profileFields'></div>
      <div class='profile-card__actions'>
        <button class='profile-card__action profile-card__action--edit' type='button'>Cambiar datos</button>
        <button class='profile-card__action profile-card__action--password' type='button'>Cambiar contraseña</button>
        <button
          class='profile-card__action profile-card__action--danger profile-card__action--logout'
          type='button'
        >Salir</button>
      </div>
    {{/if}}
  {{/if}}
  <div ref='avatarModal'></div>
</section>
