<section class='auth-card auth-card--register'>
  <h1 class='auth-card__title'>Registro</h1>

  <form class='auth-form' autocomplete='off'>
    <label class='auth-form__label' for='email'>
      Correo electronico
      <span class='auth-form__required'>*</span>
    </label>
    <input
      class='auth-form__input'
      id='email'
      name='email'
      type='email'
      required
    />

    <label class='auth-form__label' for='login'>
      Login
      <span class='auth-form__required'>*</span>
    </label>
    <input
      class='auth-form__input'
      id='login'
      name='login'
      type='text'
      required
    />

    <label class='auth-form__label' for='name'>
      Nombre
      <span class='auth-form__required'>*</span>
    </label>
    <input
      class='auth-form__input'
      id='name'
      name='name'
      type='text'
      required
    />

    <label class='auth-form__label' for='last_name'>
      Apellido
      <span class='auth-form__required'>*</span>
    </label>
    <input
      class='auth-form__input'
      id='last_name'
      name='last_name'
      type='text'
      required
    />

    <label class='auth-form__label' for='phone'>
      Telefono Celular
      <span class='auth-form__required'>*</span>
    </label>
    <input
      class='auth-form__input'
      id='phone'
      name='phone'
      type='tel'
      required
    />

    <label class='auth-form__label' for='password'>
      Password
      <span class='auth-form__required'>*</span>
    </label>
    <input
      class='auth-form__input'
      id='password'
      name='password'
      type='password'
      required
    />

    <label class='auth-form__label' for='password_repeat'>
      Password (Nuevamente)
      <span class='auth-form__required'>*</span>
    </label>
    <input
      class='auth-form__input' 
      id='password_repeat'
      name='password_repeat'
      type='password'
      required
    />

    <button class='auth-form__submit' type='submit'>Registrarse</button>
  </form>

  <a class='auth-card__link'>Ingresar</a>
</section>