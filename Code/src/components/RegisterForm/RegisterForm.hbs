<section class='auth-card auth-card--register'>
  <h1 class='auth-card__title'>Registro</h1>

  <form class='auth-form' ref='registerFormElement' autocomplete='off'>
    <div class='auth-form__group'>
      <label class='auth-form__label' for='email'>Correo electronico</label>
      <input
        class='auth-form__input'
        id='email'
        ref='emailInput'
        name='email'
        type='email'
        autocomplete='off'
      />
      <span ref='emailError' class='auth-form__field-error'></span>
    </div>

    <div class='auth-form__group'>
      <label class='auth-form__label' for='login'>Login</label>
      <input
        class='auth-form__input'
        id='login'
        ref='loginInput'
        name='login'
        type='text'
        autocomplete='off'
      />
      <span ref='loginError' class='auth-form__field-error'></span>
    </div>

    <div class='auth-form__group'>
      <label class='auth-form__label' for='name'>Nombre</label>
      <input
        class='auth-form__input'
        id='name'
        ref='nameInput'
        name='name'
        type='text'
        autocomplete='off'
      />
      <span ref='nameError' class='auth-form__field-error'></span>
    </div>

    <div class='auth-form__group'>
      <label class='auth-form__label' for='last_name'>Apellido</label>
      <input
        class='auth-form__input'
        id='last_name'
        ref='lastNameInput'
        name='last_name'
        type='text'
        autocomplete='off'
      />
      <span ref='lastNameError' class='auth-form__field-error'></span>
    </div>

    <div class='auth-form__group'>
      <label class='auth-form__label' for='phone'>Telefono Celular</label>
      <input
        class='auth-form__input'
        id='phone'
        ref='phoneInput'
        name='phone'
        type='tel'
        autocomplete='off'
      />
      <span ref='phoneError' class='auth-form__field-error'></span>
    </div>

    <div class='auth-form__group'>
      <label class='auth-form__label' for='password'>Password</label>
      <input
        class='auth-form__input'
        id='password'
        ref='passwordInput'
        name='password'
        type='password'
        autocomplete='off'
      />
      <span ref='passwordError' class='auth-form__field-error'></span>
    </div>

    <div class='auth-form__group'>
      <label class='auth-form__label' for='password_repeat'>Password
        (Nuevamente)</label>
      <input
        class='auth-form__input'
        id='password_repeat'
        ref='passwordRepeatInput'
        name='password_repeat'
        type='password'
        autocomplete='off'
      />
      <span ref='passwordRepeatError' class='auth-form__field-error'></span>
    </div>

    <p ref='generalError' class='auth-form__error'></p>

    <button
      ref='submitButton'
      class='auth-form__submit'
      type='button'
    >Registrarse</button>
  </form>

  <button
    ref='loginLinkButton'
    class='auth-card__link'
    type='button'
  >Ingresar</button>
</section>