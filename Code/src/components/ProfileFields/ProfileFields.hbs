<div class='profile-fields'>
  <div class='profile-fields__item'>
    <span class='profile-fields__label'>Correo electronico</span>
    <span class='profile-fields__value'>{{email}}</span>
  </div>
  <div class='profile-fields__item'>
    <span class='profile-fields__label'>Login</span>
    <span class='profile-fields__value'>{{login}}</span>
  </div>
  <div class='profile-fields__item'>
    <span class='profile-fields__label'>Nombre</span>
    <span class='profile-fields__value'>{{name}}</span>
  </div>
  <div class='profile-fields__item'>
    <span class='profile-fields__label'>Apellido</span>
    <span class='profile-fields__value'>{{last_name}}</span>
  </div>
  <div class='profile-fields__item'>
    <span class='profile-fields__label'>Nombre en el chat</span>
    <span class='profile-fields__value'>{{name}}</span>
  </div>
  <div class='profile-fields__item'>
    <span class='profile-fields__label'>Telefono Celular</span>
    <span class='profile-fields__value'>{{phone}}</span>
  </div>
</div>