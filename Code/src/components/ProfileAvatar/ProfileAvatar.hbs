<div class='profile-avatar'>
  {{#if avatar}}
    <img class='profile-avatar__img' src='{{avatar}}' alt='{{name}}' />
  {{else}}
    <span class='profile-avatar__placeholder'>{{firstLetter name}}</span>
  {{/if}}
  <div class='profile-avatar__overlay'>
    <img src='/Photo.svg' class='profile-avatar__overlay-icon' alt='' />
  </div>
</div>
