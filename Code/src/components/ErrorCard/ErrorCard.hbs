<div class='error-card'>
  <p class='error-card__code'>{{code}}</p>
  <h1 class='error-card__title'>{{title}}</h1>
  {{#if message}}<p class='error-card__text'>{{message}}</p>{{/if}}
  <button class='error-card__btn' type='button'>{{#if
      btnText
    }}{{btnText}}{{else}}Volver a los chats{{/if}}</button>
</div>