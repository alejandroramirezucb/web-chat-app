<form class='password-change-form' autocomplete='off'>
  <div class='password-change-form__group'>
    <label class='password-change-form__label' for='pcf-old'>Contraseña actual</label>
    <input
      class='password-change-form__input'
      id='pcf-old'
      ref='oldPasswordInput'
      name='old_password'
      type='password'
      autocomplete='off'
    />
    <span ref='oldPasswordError' class='password-change-form__field-error'></span>
  </div>

  <div class='password-change-form__group'>
    <label class='password-change-form__label' for='pcf-new'>Nueva contraseña</label>
    <input
      class='password-change-form__input'
      id='pcf-new'
      ref='newPasswordInput'
      name='new_password'
      type='password'
      autocomplete='off'
    />
    <span ref='newPasswordError' class='password-change-form__field-error'></span>
  </div>

  <div class='password-change-form__group'>
    <label class='password-change-form__label' for='pcf-repeat'>Repetir nueva contraseña</label>
    <input
      class='password-change-form__input'
      id='pcf-repeat'
      ref='repeatPasswordInput'
      name='repeat_password'
      type='password'
      autocomplete='off'
    />
    <span ref='repeatPasswordError' class='password-change-form__field-error'></span>
  </div>

  <p ref='generalError' class='password-change-form__error'></p>

  <div class='password-change-form__actions'>
    <button ref='saveButton' class='password-change-form__save' type='button'>Guardar</button>
    <button ref='cancelButton' class='password-change-form__cancel' type='button'>Cancelar</button>
  </div>
</form>
